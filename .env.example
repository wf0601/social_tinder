# Social Tinder — Brandwatch configuration
#
# Leave these unset to run on the bundled synthetic dataset (the app shows an
# amber "Sample data" badge). Set them to pull live Brandwatch Consumer
# Research mentions (badge turns green: "Live Brandwatch").

# OAuth2 bearer token for the Brandwatch API.
BRANDWATCH_API_TOKEN=

# Consumer Research project id to pull mentions from.
BRANDWATCH_PROJECT_ID=

# Optional: a saved query/search id within the project.
BRANDWATCH_QUERY_ID=

# Optional: override the API base URL.
# BRANDWATCH_API_BASE=https://api.brandwatch.com
